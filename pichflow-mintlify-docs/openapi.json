{
  "openapi": "3.1.0",
  "info": {
    "title": "PichFlow API",
    "version": "1.0.0",
    "description": "Spécification partielle générée à partir des handlers Express de ce dépôt. Les chemins incluent le préfixe /api; l'origine de production n'est pas définie dans le code."
  },
  "security": [
    {
      "BearerApiKey": []
    }
  ],
  "tags": [
    { "name": "Paiements" },
    { "name": "Transactions" },
    { "name": "Payouts" },
    { "name": "Portefeuilles" },
    { "name": "Références" },
    { "name": "Webhooks" }
  ],
  "components": {
    "securitySchemes": {
      "BearerApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "PichFlow API key",
        "description": "Clé API Sandbox sk_test_... ou Live sk_live_...."
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": false,
        "description": "Valeur stable à réutiliser pour les reprises d'une même opération. Le serveur en génère une si elle est omise sur les handlers qui l'utilisent.",
        "schema": { "type": "string" }
      },
      "PaymentId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Identifiant de paiement transmis au service fournisseur."
      },
      "TransactionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Identifiant ou référence de transaction."
      },
      "Reference": {
        "name": "reference",
        "in": "path",
        "required": true,
        "schema": { "type": "string" },
        "description": "Référence interne PichFlow."
      }
    },
    "schemas": {
      "Amount": {
        "oneOf": [
          { "type": "string", "examples": ["5000.00"] },
          { "type": "number", "exclusiveMinimum": 0, "examples": [5000] }
        ],
        "description": "Le serveur normalise le montant avant l'appel fournisseur. Les exemples utilisent une chaîne décimale."
      },
      "Customer": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" }
        },
        "additionalProperties": true
      },
      "SoftpayRequest": {
        "type": "object",
        "required": ["amount", "network", "customer"],
        "properties": {
          "amount": { "$ref": "#/components/schemas/Amount" },
          "currency": { "type": "string", "default": "XOF" },
          "country": { "type": "string", "default": "BJ" },
          "network": { "type": "string", "examples": ["mtn_bj"] },
          "customer": { "$ref": "#/components/schemas/Customer" },
          "description": { "type": "string" },
          "fee_charge_mode": { "type": "string", "enum": ["ADD_ON", "DEDUCTED"] },
          "otp": { "type": "string" }
        }
      },
      "CheckoutSessionRequest": {
        "type": "object",
        "required": ["amount", "customer_name", "customer_email"],
        "properties": {
          "amount": { "$ref": "#/components/schemas/Amount" },
          "currency": { "type": "string", "default": "XOF" },
          "country": { "type": "string" },
          "customer_name": { "type": "string" },
          "customer_email": { "type": "string", "format": "email" },
          "customer_phone": { "type": "string" },
          "description": { "type": "string" },
          "return_url": { "type": "string", "format": "uri" },
          "metadata": { "type": "object", "additionalProperties": true }
        }
      },
      "CreatePaymentRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": { "$ref": "#/components/schemas/Amount" },
          "currency": { "type": "string", "default": "XOF" },
          "description": { "type": "string" },
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string", "format": "email" },
          "customerPhone": { "type": "string" },
          "country": { "type": "string", "default": "BJ" },
          "network": { "type": "string" },
          "otp": { "type": "string" },
          "returnUrl": { "type": "string", "format": "uri" }
        },
        "description": "Le handler choisit Softpay si network et customerPhone sont présents, sinon checkout hébergé."
      },
      "PayoutRequest": {
        "type": "object",
        "required": ["amount", "currency", "country", "method", "recipient"],
        "properties": {
          "amount": { "$ref": "#/components/schemas/Amount" },
          "currency": { "type": "string" },
          "country": { "type": "string" },
          "method": { "type": "string" },
          "customer": { "$ref": "#/components/schemas/Customer" },
          "recipient": {
            "type": "object",
            "required": ["msisdn"],
            "properties": {
              "msisdn": { "type": "string" }
            },
            "additionalProperties": true
          },
          "description": { "type": "string" },
          "fee_charge_mode": { "type": "string", "enum": ["ADD_ON", "DEDUCTED"] }
        }
      },
      "WalletTransferRequest": {
        "type": "object",
        "required": ["from_country", "to_country", "from_amount"],
        "properties": {
          "from_country": { "type": "string" },
          "to_country": { "type": "string" },
          "from_amount": { "$ref": "#/components/schemas/Amount" }
        }
      },
      "OtpRequest": {
        "type": "object",
        "required": ["otp"],
        "properties": {
          "otp": { "type": "string" }
        }
      },
      "GenericSuccess": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "environment": { "type": "string", "enum": ["sandbox", "live"] },
          "data": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": true
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "const": false },
          "error": { "type": "string" },
          "code": { "type": "string" },
          "environment": { "type": "string", "enum": ["sandbox", "live"] },
          "data": {}
        },
        "additionalProperties": true
      }
    },
    "responses": {
      "Error": {
        "description": "Réponse d'erreur JSON; le statut et le détail peuvent être relayés par le fournisseur.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "GenericJson": {
        "description": "Réponse JSON du handler ou du service fournisseur. La forme exacte de data dépend de SasPay.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/GenericSuccess" }
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/payments/create": {
      "post": {
        "tags": ["Paiements"],
        "operationId": "createPayment",
        "summary": "Créer un paiement",
        "description": "Choisit Softpay si network et customerPhone sont transmis; sinon crée une session de checkout.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePaymentRequest" }
            }
          }
        },
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payments/softpay": {
      "post": {
        "tags": ["Paiements"],
        "operationId": "createSoftpayPayment",
        "summary": "Initier un paiement Softpay",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SoftpayRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/checkout-sessions": {
      "post": {
        "tags": ["Paiements"],
        "operationId": "createCheckoutSession",
        "summary": "Créer une session de checkout hébergé",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckoutSessionRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payments/{id}/verify": {
      "get": {
        "tags": ["Paiements"],
        "operationId": "verifyPayment",
        "summary": "Vérifier un paiement auprès du fournisseur",
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payments/{id}/confirm-otp": {
      "post": {
        "tags": ["Paiements"],
        "operationId": "confirmPaymentOtp",
        "summary": "Transmettre un code OTP",
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/OtpRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payments/{id}/retry": {
      "post": {
        "tags": ["Paiements"],
        "operationId": "retryPayment",
        "summary": "Relancer une tentative de paiement",
        "parameters": [
          { "$ref": "#/components/parameters/PaymentId" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payments/status/{reference}": {
      "get": {
        "tags": ["Paiements"],
        "operationId": "getPaymentStatusByReference",
        "summary": "Lire le statut interne par référence",
        "parameters": [{ "$ref": "#/components/parameters/Reference" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/transactions": {
      "get": {
        "tags": ["Transactions"],
        "operationId": "listTransactions",
        "summary": "Lister les transactions",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Défaut handler : 50. Le code ne définit pas de plafond.",
            "schema": { "type": "integer", "default": 50 }
          }
        ],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/transactions/{id}": {
      "get": {
        "tags": ["Transactions"],
        "operationId": "getTransaction",
        "summary": "Lire une transaction par identifiant ou référence",
        "parameters": [{ "$ref": "#/components/parameters/TransactionId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/transactions/{id}/invoice": {
      "get": {
        "tags": ["Transactions"],
        "operationId": "getTransactionInvoice",
        "summary": "Demander une facture au fournisseur",
        "description": "Le handler local renvoie le résultat du service sous forme JSON; il ne garantit pas un téléchargement PDF.",
        "parameters": [{ "$ref": "#/components/parameters/TransactionId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payouts/initialize": {
      "post": {
        "tags": ["Payouts"],
        "operationId": "initializePayout",
        "summary": "Initialiser un payout",
        "description": "Nécessite un scope de clé payout ou both et un solde local suffisant.",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PayoutRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "422": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/payouts/{id}/verify": {
      "get": {
        "tags": ["Payouts"],
        "operationId": "verifyPayout",
        "summary": "Vérifier un payout",
        "parameters": [{ "$ref": "#/components/parameters/PaymentId" }],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/wallets/balances": {
      "get": {
        "tags": ["Portefeuilles"],
        "operationId": "getWalletBalances",
        "summary": "Consulter les soldes retournés par SasPay",
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/wallets/rates": {
      "get": {
        "tags": ["Portefeuilles"],
        "operationId": "getWalletRates",
        "summary": "Consulter les taux retournés par SasPay",
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/wallets/transfer": {
      "post": {
        "tags": ["Portefeuilles"],
        "operationId": "createWalletTransfer",
        "summary": "Créer un transfert inter-pays",
        "parameters": [{ "$ref": "#/components/parameters/IdempotencyKey" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WalletTransferRequest" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/reference/countries": {
      "get": {
        "tags": ["Références"],
        "operationId": "listCountries",
        "summary": "Lister les pays du fournisseur",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/reference/networks": {
      "get": {
        "tags": ["Références"],
        "operationId": "listNetworks",
        "summary": "Lister les réseaux du fournisseur",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/reference/rates": {
      "get": {
        "tags": ["Références"],
        "operationId": "getReferenceRates",
        "summary": "Lire les tarifs renvoyés par le fournisseur",
        "security": [],
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/webhooks/saspay": {
      "post": {
        "tags": ["Webhooks"],
        "operationId": "receiveSasPayWebhook",
        "summary": "Recevoir un webhook SasPay",
        "description": "Vérifie le HMAC-SHA-256 du timestamp concaténé au corps brut avec un point; fenêtre de tolérance de 300 secondes.",
        "security": [],
        "parameters": [
          {
            "name": "X-Webhook-Signature",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-Webhook-Timestamp",
            "in": "header",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "X-Webhook-Event",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Le code utilise cet en-tête, ou event dans le JSON."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "event": { "type": "string" },
                  "id": { "type": "string" },
                  "data": { "type": "object", "additionalProperties": true }
                },
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/GenericJson" },
          "401": { "$ref": "#/components/responses/Error" },
          "500": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  }
}
