{
  "$schema": "https://mintlify.com/docs.json",
  "name": "PichFlow",
  "description": "Documentation développeur PichFlow : intégration des paiements, opérations et API.",
  "theme": "mint",
  "logo": "/img/log.png",
  "favicon": "/img/log.png",
  "colors": {
    "primary": "#5E30E8",
    "light": "#7C4DFF",
    "dark": "#4520B0"
  },
  "api": {
