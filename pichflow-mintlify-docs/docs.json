        ]
      },
      {
        "group": "Opérations",
        "pages": [
          "customers-transactions",
          "wallets",
          "payouts",
          "countries-networks"
        ]
      },
      {
        "group": "Intégration",
        "pages": [
          "webhooks",
          "errors",
          "code-samples",
          "real-payloads"
        ]
      },
      {
        "group": "Référence",
        "pages": [
          "api-reference"
