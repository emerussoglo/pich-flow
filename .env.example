# ==============================================================================
# PichFlow Platform - Environment Variables Template
# ==============================================================================

# Application URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Database Configuration (Turso libSQL)
TURSO_DATABASE_URL="libsql://your-database-name.aws-ca-central-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# SasPay Gateway Configuration
# Official Base URL: https://api.saspay.me/api/v1
SASPAY_BASE_URL="https://api.saspay.me/api/v1"

# SasPay Secret Keys (Prefix sk_test_... for Sandbox, sk_live_... for Live)
# Obtain these from your SasPay merchant dashboard (https://saspay.me)
SASPAY_API_KEY_TEST="sk_test_your_sandbox_key_here"
SASPAY_API_KEY_LIVE="sk_live_your_live_key_here"

# SasPay Webhook Signing Secret (HMAC SHA-256)
# Configured in SasPay Dashboard > Webhooks
SASPAY_WEBHOOK_SECRET="whsec_your_webhook_signing_secret_here"

# Authentication & Encryption Secrets (Server-side only)
# AUTH_SECRET: Used for session tokens and JWT verification (min 32 chars)
AUTH_SECRET="your_secure_random_auth_secret_min_32_characters_here"

# ENCRYPTION_KEY: 32-byte hex string (64 characters) for AES-256 key encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email Configuration (SMTP Nodemailer)
# Gmail Note: Use a 16-character App Password (from myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contactpichflow@gmail.com"
SMTP_PASSWORD="your_app_specific_password_here"
EMAIL_FROM="contactpichflow@gmail.com"
SMTP_FROM_NAME="PichFlow Security"

# Optional Mock for local testing without active SMTP credentials:
# SMTP_MOCK="true"
