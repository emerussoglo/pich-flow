# ==============================================================================
# PichFlow Platform - Environment Variables Template
# ==============================================================================

# Application URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Database Configuration (Turso libSQL)
TURSO_DATABASE_URL="libsql://your-database-name.aws-ca-central-1.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token_here"

# PayDunya checkout configuration (server-side only)
# Keep sandbox selected for local testing. Production must explicitly set PAYDUNYA_MODE=live.
PAYDUNYA_MODE="sandbox"
PAYDUNYA_MASTER_KEY="your_paydunya_master_key_here"
PAYDUNYA_PRIVATE_KEY="test_private_your_sandbox_key_here"
PAYDUNYA_PUBLIC_KEY="test_public_your_sandbox_key_here"
PAYDUNYA_TOKEN="your_paydunya_sandbox_token_here"

# Authentication & Encryption Secrets (Server-side only)
# AUTH_SECRET: Used for session tokens and JWT verification (min 32 chars)
AUTH_SECRET="your_secure_random_auth_secret_min_32_characters_here"

# ENCRYPTION_KEY: 32-byte hex string (64 characters) for AES-256 key encryption
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Email Configuration (SMTP Nodemailer)
# Gmail Note: Use a 16-character App Password (from myaccount.google.com/apppasswords)
# Gmail direct TLS uses port 465 with SMTP_SECURE=true; port 587 uses STARTTLS with SMTP_SECURE=false.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="contactpichflow@gmail.com"
SMTP_PASSWORD="your_app_specific_password_here"
EMAIL_FROM="contactpichflow@gmail.com"
SMTP_FROM_NAME="PichFlow Security"

# Optional Mock for local testing without active SMTP credentials:
# SMTP_MOCK="true"
