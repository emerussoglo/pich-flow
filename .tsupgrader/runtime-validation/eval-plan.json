{
  "projectType": "webapp",
  "setup": [],
  "assertions": [
    {
      "name": "typescript-no-emit",
      "kind": "process",
      "command": "npm",
      "args": ["run", "lint"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "api-and-payment-tests",
      "kind": "process",
      "command": "npm",
      "args": ["test"],
      "verificationMethod": "test-results",
      "expected": "0",
      "timeoutSeconds": 180
    },
    {
      "name": "next-production-build",
      "kind": "process",
      "command": "npm",
      "args": ["run", "build"],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 240
    },
    {
      "name": "openapi-document-is-valid-json",
      "kind": "process",
      "command": "node",
      "args": [
        "--input-type=module",
        "-e",
        "import { readFileSync } from 'node:fs'; JSON.parse(readFileSync('pichflow-mintlify-docs\\\\api-v1.openapi.json', 'utf8'));"
      ],
      "verificationMethod": "exit-code",
      "expected": "0",
      "timeoutSeconds": 30
    },
    {
      "name": "production-homepage-responds",
      "kind": "http-probe",
      "startCommand": "npm",
      "startArgs": ["run", "start"],
      "url": "http://localhost:3000/",
      "verificationMethod": "http-status",
      "expected": "200",
      "timeoutSeconds": 90
    }
  ]
}
